#include "include/{{projectName}}/{{pluginClassSnakeCase}}.h"

#include <sys/utsname.h>

#include <memory>
#include <string>

#include "messages.g.h"
#include "{{pluginClassSnakeCase}}_private.h"

namespace {{projectName}} {

{{pluginClass}}::{{pluginClass}}(flutter::BinaryMessenger* messenger)
    : messenger_(messenger) {
  if (messenger_ != nullptr) {
    {{pluginClass}}Api::SetUp(messenger_, this);
  }
}

{{pluginClass}}::~{{pluginClass}}() {
  if (messenger_ != nullptr) {
    {{pluginClass}}Api::SetUp(messenger_, nullptr);
  }
}

ErrorOr<std::string> {{pluginClass}}::GetPlatformVersion() {
  struct utsname uname_data = {};
  uname(&uname_data);
  return std::string("Linux ") + uname_data.version;
}

}  // namespace {{projectName}}

void {{pluginClass}}RegisterWithEngine(flutter::FlutterDesktopEngine& engine) {
  engine.add_plugin(
      std::make_unique<{{projectName}}::{{pluginClass}}>(engine.messenger()));
}
