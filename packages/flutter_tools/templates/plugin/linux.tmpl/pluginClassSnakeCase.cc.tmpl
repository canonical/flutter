#include "include/{{projectName}}/{{pluginClassSnakeCase}}.h"

#include <flutter/plugin_registrar_linux.h>
#include <sys/utsname.h>

#include <memory>
#include <string>

#include "messages.g.h"
#include "{{pluginClassSnakeCase}}_private.h"

namespace {{projectName}} {

// static
void {{pluginClass}}::RegisterWithRegistrar(
    flutter::PluginRegistrarLinux* registrar) {
  auto plugin = std::make_unique<{{pluginClass}}>();
  {{pluginClass}}Api::SetUp(registrar->messenger(), plugin.get());
  registrar->AddPlugin(std::move(plugin));
}

{{pluginClass}}::{{pluginClass}}() {}

{{pluginClass}}::~{{pluginClass}}() {}

ErrorOr<std::string> {{pluginClass}}::GetPlatformVersion() {
  struct utsname uname_data = {};
  uname(&uname_data);
  return std::string("Linux ") + uname_data.version;
}

}  // namespace {{projectName}}

void {{pluginClass}}RegisterWithRegistrar(
    FlutterDesktopPluginRegistrarRef registrar) {
  {{projectName}}::{{pluginClass}}::RegisterWithRegistrar(
      flutter::PluginRegistrarManager::GetInstance()
          ->GetRegistrar<flutter::PluginRegistrarLinux>(registrar));
}
