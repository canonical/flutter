# The archive of the embedder that the flutter tool downloads.
zip_bundle("flutter_linux_archive") {
  prefix = "$full_target_platform_name-$flutter_runtime_mode/"
  output = "${prefix}${full_target_platform_name}-flutter.zip"
  deps = [
    ":flutter_linux",
    ":publish_headers_linux",
    ":publish_wrapper_linux",
    "$dart_src/runtime/bin:gen_snapshot",
  ]
  sources = get_target_outputs(":publish_headers_linux")
  tmp_files = []
  foreach(source, sources) {
    tmp_files += [
      {
        source = source
        destination = rebase_path(source, "$root_build_dir")
      },
    ]
  }
  tmp_files += [
    {
      source = "$root_build_dir/libflutter_linux.so"
      destination = "libflutter_linux.so"
    },
    {
      source = "$root_build_dir/gen_snapshot"
      destination = "gen_snapshot"
    },
  ]

  # The C++ channels the runner and plugins are built with.
  foreach(source, channel_cpp_client_wrapper_sources) {
    tmp_files += [
      {
        source = source
        destination = "cpp_client_wrapper/" + get_path_info(source, "file")
      },
    ]
  }
  foreach(source, channel_cpp_client_wrapper_includes) {
    tmp_files += [
      {
        source = source
        destination = "cpp_client_wrapper/include/flutter/" +
                      get_path_info(source, "file")
      },
    ]
  }
  files = tmp_files
}
