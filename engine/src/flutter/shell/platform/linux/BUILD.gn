copy("publish_headers_linux") {
  sources = _public_headers +
            [ "//flutter/shell/platform/common/public/flutter_export.h" ]
  outputs = [ "$root_out_dir/flutter_linux/{{source_file_part}}" ]
}

# The C++ channels and codecs the runner and plugins are built with. The rest
# of the common client wrapper is replaced by flutter_linux.h.
copy("publish_wrapper_linux_includes") {
  sources = channel_cpp_client_wrapper_includes
  outputs = [
    "$root_out_dir/cpp_client_wrapper/include/flutter/{{source_file_part}}",
  ]
}

copy("publish_wrapper_linux") {
  sources = channel_cpp_client_wrapper_sources
  outputs = [ "$root_out_dir/cpp_client_wrapper/{{source_file_part}}" ]
  public_deps = [ ":publish_wrapper_linux_includes" ]
}

