assert(is_linux)

import("//flutter/build/zip_bundle.gni")
import("//flutter/shell/platform/common/client_wrapper/core_wrapper_files.gni")
import("//flutter/shell/platform/glfw/config.gni")
import("//flutter/testing/testing.gni")

group("linux") {
  deps = [
    ":flutter_linux",
    ":publish_headers_linux",
    ":publish_wrapper_linux",
  ]
  if (build_glfw_shell) {
    deps += [
      ":flutter_linux_glfw",
      "//flutter/shell/platform/glfw:publish_headers_glfw",
      "//flutter/shell/platform/glfw/client_wrapper:publish_wrapper_glfw",
    ]
  }
}

# Temporary workaround for the issue describe in
# https://github.com/flutter/flutter/issues/14509 and
# https://github.com/flutter/flutter/issues/14438
# Remove once the build infrastructure moves to Ubuntu 18.04 or newer, where
# the underlying issue is fixed.
config("disable_fatal_link_warnings") {
  visibility = [ ":*" ]
  ldflags = [ "-Wl,--no-fatal-warnings" ]
}

if (build_glfw_shell) {
  shared_library("flutter_linux_glfw") {
    deps = [ "//flutter/shell/platform/glfw:flutter_glfw" ]

    configs += [ ":disable_fatal_link_warnings" ]

    public_configs = [ "//flutter:config" ]
  }
}

_public_headers = [
  "public/flutter_linux.h",
  "public/flutter_linux_abi.h",
]

# Wayland protocols used by the embedder. The bindings are generated with an
# in-tree scanner so the generated code is compatible with the libwayland in
# the sysroot. The core protocol is included so core interfaces can be used at
# newer versions than the installed libwayland supports.
_wayland_protocols = [
  "protocols/cursor-shape-v1.xml",
  "protocols/fifo-v1.xml",
  "protocols/fractional-scale-v1.xml",
  "protocols/linux-dmabuf-v1.xml",
  "protocols/linux-drm-syncobj-v1.xml",
  "protocols/pointer-gestures-unstable-v1.xml",
  "protocols/presentation-time.xml",
  "protocols/tablet-v2.xml",
  "protocols/text-input-unstable-v3.xml",
  "protocols/viewporter.xml",
  "protocols/wayland.xml",
  "protocols/xdg-activation-v1.xml",
  "protocols/xdg-decoration-unstable-v1.xml",
  "protocols/xdg-dialog-v1.xml",
  "protocols/xdg-output-unstable-v1.xml",
  "protocols/xdg-shell.xml",
]

action_foreach("wayland_protocols_generate") {
  script = "tools/wayland_scanner.py"
  sources = _wayland_protocols
  _header = "$target_gen_dir/protocols/{{source_name_part}}-client-protocol.h"
  _code = "$target_gen_dir/protocols/{{source_name_part}}-protocol.c"
  outputs = [
    _header,
    _code,
  ]
  args = [
    "{{source}}",
    rebase_path(_header, root_build_dir),
    rebase_path(_code, root_build_dir),
  ]
}

source_set("wayland_protocols") {
  sources = get_target_outputs(":wayland_protocols_generate")
  public_configs = [ "//flutter/shell/platform/linux/config:wayland_client" ]
  deps = [ ":wayland_protocols_generate" ]
}

# The public headers are a separate source set since client code is allowed to
# depend on them, but none of the rest of the code.
source_set("flutter_linux_headers") {
  public = _public_headers

  public_deps = [ "//flutter/shell/platform/common:common_cpp_library_headers" ]

  configs +=
      [ "//flutter/shell/platform/common:desktop_library_implementation" ]

  public_configs = [
    ":relative_flutter_linux_headers",
    "//flutter/shell/platform/common:relative_flutter_library_headers",
  ]
}

config("relative_flutter_linux_headers") {
  include_dirs = [
    "public",

    # flutter_linux.h includes <flutter/binary_messenger.h>.
    "//flutter/shell/platform/common/client_wrapper/include",
  ]
}

# Stops the EGL headers including Xlib, which defines macros that conflict
# with other code.
config("no_x11") {
  defines = [ "EGL_NO_X11" ]
}

