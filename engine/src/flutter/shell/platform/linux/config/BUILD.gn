import("//build/config/linux/pkg_config.gni")

# The only system libraries the Linux embedder depends on.
_pkg_configs = [
  {
    name = "egl"
    packages = [ "egl" ]
  },
  {
    name = "gbm"
    packages = [ "gbm" ]
  },
  {
    name = "glesv2"
    packages = [ "glesv2" ]
  },
  {
    name = "libdrm"
    packages = [ "libdrm" ]
  },
  {
    name = "wayland_client"
    packages = [ "wayland-client" ]
  },
  {
    name = "xcb"
    packages = [
      "xcb",
      "xcb-dri3",
      "xcb-present",
      "xcb-randr",
      "xcb-shape",
      "xcb-shm",
    ]
  },
  {
    name = "xkbcommon"
    packages = [ "xkbcommon" ]
  },
]

foreach(pkg, _pkg_configs) {
  if (!is_minimal_linux) {
    pkg_config(pkg.name) {
      packages = pkg.packages
    }
  } else {
    config(pkg.name) {
    }
  }
}
