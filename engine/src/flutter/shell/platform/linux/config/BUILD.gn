import("//build/config/linux/pkg_config.gni")

# The only system libraries the Linux embedder depends on.
_pkg_configs = [
  {
    name = "egl"
    package = "egl"
  },
  {
    name = "gbm"
    package = "gbm"
  },
  {
    name = "glesv2"
    package = "glesv2"
  },
  {
    name = "libdrm"
    package = "libdrm"
  },
  {
    name = "wayland_client"
    package = "wayland-client"
  },
]

foreach(pkg, _pkg_configs) {
  if (!is_minimal_linux) {
    pkg_config(pkg.name) {
      packages = [ pkg.package ]
    }
  } else {
    config(pkg.name) {
    }
  }
}
